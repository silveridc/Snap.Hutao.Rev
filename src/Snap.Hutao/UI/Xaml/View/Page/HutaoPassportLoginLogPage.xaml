<shuxc:ScopedPage
    x:Class="Snap.Hutao.Rev.UI.Xaml.View.Page.HutaoPassportLoginLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Rev.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Rev.UI.Xaml.Control"
    xmlns:shuxm="using:Snap.Hutao.Rev.UI.Xaml.Markup"
    xmlns:shvh="using:Snap.Hutao.Rev.ViewModel.HutaoPassport"
    d:DataContext="{d:DesignInstance shvh:HutaoPassportLoginLogViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <Border VerticalAlignment="Top" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel Spacing="12">
                        <cwc:SettingsCard
                            Description="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogDescription}"
                            Header="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogHeader}"
                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE81C;}"/>

                        <Grid
                            Padding="12,4"
                            ColumnSpacing="12"
                            Opacity="0.7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogTime}"/>
                            <TextBlock
                                Grid.Column="1"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogMethod}"/>
                            <TextBlock
                                Grid.Column="2"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogResult}"/>
                            <TextBlock
                                Grid.Column="3"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogIp}"/>
                            <TextBlock
                                Grid.Column="4"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogRegion}"/>
                            <TextBlock
                                Grid.Column="5"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogDevice}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="shvh:AccountLoginLogView">
                                    <Grid
                                        Padding="12,8"
                                        ColumnSpacing="12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding Time}"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding Method}"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding Result}"/>
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding Ip}"/>
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding Region}"
                                            TextTrimming="CharacterEllipsis"/>
                                        <TextBlock
                                            Grid.Column="5"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding Device}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Margin="0,16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{shuxm:ResourceString Name=ViewPageHutaoPassportLoginLogEmpty}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</shuxc:ScopedPage>
