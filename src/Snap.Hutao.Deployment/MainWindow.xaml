<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snap.Hutao.Deployment.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snap.Hutao.Rev Deployment">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42.5*"/>
            <ColumnDefinition Width="57.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Padding="8">
            <Image x:Name="ArtworkImage" Stretch="Uniform"/>
            <TextBlock
                x:Name="VersionTextBlock"
                Margin="14,0,0,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="12"
                Opacity="0.8"
                Text="胡桃启动器"/>
        </Grid>

        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Padding="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <Image
                    x:Name="TitleImage"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"/>
                <TextBlock
                    x:Name="HeaderTextBlock"
                    FontSize="25"
                    FontWeight="SemiBold"
                    LineHeight="28"
                    Text="正在更新胡桃启动器"/>
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="0,8,0,0"
                Spacing="2">
                <TextBlock
                    x:Name="DetailTextBlock"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="正在获取版本信息"
                    TextWrapping="Wrap"/>
                <TextBlock
                    x:Name="StatusTextBlock"
                    FontFamily="Consolas"
                    FontSize="12"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel
                Grid.Row="2"
                Margin="0,20,0,0"
                Spacing="10">
                <StackPanel
                    x:Name="StepConnect"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Grid
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="StepConnectDot"
                            Width="4"
                            Height="4"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}"
                            Opacity="0.5"/>
                        <FontIcon
                            x:Name="StepConnectDone"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE73E;"
                            Visibility="Collapsed"/>
                        <ProgressRing
                            x:Name="StepConnectRing"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock
                        x:Name="StepConnectText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="获取更新信息"/>
                </StackPanel>
                <StackPanel
                    x:Name="StepDownload"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Grid
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="StepDownloadDot"
                            Width="4"
                            Height="4"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}"
                            Opacity="0.5"/>
                        <FontIcon
                            x:Name="StepDownloadDone"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE73E;"
                            Visibility="Collapsed"/>
                        <ProgressRing
                            x:Name="StepDownloadRing"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock
                        x:Name="StepDownloadText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="下载更新包"/>
                </StackPanel>
                <StackPanel
                    x:Name="StepVerify"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Grid
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="StepVerifyDot"
                            Width="4"
                            Height="4"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}"
                            Opacity="0.5"/>
                        <FontIcon
                            x:Name="StepVerifyDone"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE73E;"
                            Visibility="Collapsed"/>
                        <ProgressRing
                            x:Name="StepVerifyRing"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock
                        x:Name="StepVerifyText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="校验 SHA-256"/>
                </StackPanel>
                <StackPanel
                    x:Name="StepInstall"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Grid
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="StepInstallDot"
                            Width="4"
                            Height="4"
                            Fill="{ThemeResource TextFillColorSecondaryBrush}"
                            Opacity="0.5"/>
                        <FontIcon
                            x:Name="StepInstallDone"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE73E;"
                            Visibility="Collapsed"/>
                        <ProgressRing
                            x:Name="StepInstallRing"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock
                        x:Name="StepInstallText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="安装更新包"/>
                </StackPanel>
            </StackPanel>
            <Grid
                x:Name="ReleaseNotesPanel"
                Grid.Row="3"
                Margin="0,20,0,0"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="更新内容"/>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="ReleaseNotesTextBlock"
                        LineHeight="20"
                        Opacity="0.85"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>

            <Grid
                Grid.Row="4"
                Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ErrorTextBlock"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.8"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"/>
                <Button
                    x:Name="ActionButton"
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    Content="取消"/>
            </Grid>
        </Grid>

        <ProgressBar
            x:Name="ProgressBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Height="4"
            MinHeight="4"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
            IsIndeterminate="True"/>
    </Grid>
</Window>
